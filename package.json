{
  "name": "pi-team-room",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, machine-wide shared context room for Pi, Claude Code, and Codex sessions",
  "keywords": ["pi-package"],
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "npm run test:core && npm run test:network && npm run test:mcp && npm run test:irc",
    "test:core": "node test/harness.mjs",
    "test:network": "node test/network-service.mjs",
    "test:mcp": "node test/mcp-server.mjs",
    "test:irc": "node test/irc-service.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "bonjour-service": "^1.4.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./extension.ts"]
  }
}
